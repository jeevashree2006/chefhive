# Copy this file to server/.env and fill in your own MySQL details.
# Never commit .env: it is listed in .gitignore.

PORT=4000
CLIENT_ORIGIN=http://localhost:5173

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=chefhive

# Any long random string. Send it as the "x-admin-token" header to read /api/admin/*.
ADMIN_TOKEN=change-me
